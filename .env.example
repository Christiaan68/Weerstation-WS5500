# ---------------------------------------------------------------------------
# Omgevingsvariabelen voor het Alecto WS5500 Weerstation-project
#
# Kopieer dit bestand naar `.env.local` voor lokale ontwikkeling en vul de
# echte waarden in. Zet ECHTE waarden NOOIT in git — .env.local staat in
# .gitignore. Voor Vercel: zet dezelfde variabelen in
# Project Settings → Environment Variables (zie docs/VERCEL_SETUP.md).
# ---------------------------------------------------------------------------

# --- Database (TiDB Cloud, MySQL-compatible) --------------------------------
# Volledige connection string inclusief SSL, bijvoorbeeld:
# mysql://<user>:<password>@<host>:4000/<database>?ssl={"rejectUnauthorized":true}
# Zie docs/TIDB_SETUP.md voor het exact opbouwen van deze waarde.
DATABASE_URL=mysql://user:password@host:4000/weerstation?ssl={"rejectUnauthorized":true}

# --- Publieke configuratie (zichtbaar in de browserbundle) ------------------
NEXT_PUBLIC_STATION_NAME=Alecto WS5500
NEXT_PUBLIC_TIMEZONE=Europe/Amsterdam

# Toon duidelijk "demo-gegevens" in de UI wanneer er nog geen echte
# weerstation-data binnenkomt. Zet op "false" zodra er echte data is.
NEXT_PUBLIC_DEMO_MODE=true

# --- Data-ingestie (Fase 2) --------------------------------------------------
# Geheime waarde in het pad van het ingestie-endpoint
# (/api/weather/ingest/<WEATHER_INGEST_SECRET>). Kies een lange, willekeurige
# waarde (bv. gegenereerd met `openssl rand -hex 32`). Zie docs/WS5500_SETUP.md.
WEATHER_INGEST_SECRET=changeme_ingest_secret

# Geheime sleutel voor de diagnosepagina (/station/diagnostics?key=...).
# Bewust een ANDERE waarde dan WEATHER_INGEST_SECRET (scheiding van
# verantwoordelijkheden: het lekken van de ene sleutel lekt niet de andere).
# Leeg laten = de diagnosepagina is uitgeschakeld (geeft altijd 404).
STATION_DIAGNOSTICS_SECRET=changeme_diagnostics_secret

# Geheime sleutel voor het stationbeheerscherm (/admin/stations?key=...),
# Fase 5.2. Bewust een ANDERE waarde dan STATION_DIAGNOSTICS_SECRET: dit
# scherm kan stations aanmaken/wijzigen (schrijftoegang), de diagnosepagina
# is alleen-lezen. Leeg laten = het beheerscherm is uitgeschakeld (404).
STATION_ADMIN_SECRET=changeme_admin_secret

# Ecowitt Cloud API-credentials — nodig voor de fallback-ingestieroute als
# een rechtstreekse HTTPS-upload vanaf het station niet werkt (zie
# docs/WS5500_INGESTION.md §Waarom een fallback nodig is). Aanvragen via
# https://www.ecowitt.net (Mijn account → API-sleutel) en de app-sleutel via
# https://www.ecowitt.net/home/help?id=768.
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_DEVICE_MAC=
